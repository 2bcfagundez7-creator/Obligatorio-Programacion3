@model List<Obligatorio.WebLectores.Models.LecturaHistorialDTO>
@{
    ViewData["Title"] = "Mis lecturas";
    int mes = (int)ViewBag.Mes;
    int anio = (int)ViewBag.Anio;
}
<h1>Mis lecturas</h1>
<p class="text-body-secondary">RF08 · Aventuras que empezaste y las que ya terminaste.</p>

<form method="get" asp-controller="Historial" asp-action="Index" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label" for="mes">Mes</label>
        <select id="mes" name="mes" class="form-select">
            @for (int numero = 1; numero <= 12; numero++)
            {
                <option value="@numero" selected="@(numero == mes)">@numero</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label" for="anio">Año</label>
        <input type="number" min="1900" max="2100" name="anio" id="anio" value="@anio" class="form-control" />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Consultar</button></div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Count == 0)
{
    <div class="empty-state">
        No hay lecturas registradas para el mes y año seleccionados.
        <a asp-controller="Historias" asp-action="Index">Explorar historias</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Historia</th>
                    <th>Inicio</th>
                    <th>Finalización</th>
                    <th>Final alcanzado</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lectura in Model)
                {
                    <tr>
                        <td class="fw-semibold">@lectura.TituloHistoria</td>
                        <td>@lectura.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(lectura.FechaFinalizacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>@(lectura.NombreFinal ?? "—")</td>
                        <td>
                            @if (lectura.Finalizada)
                            {
                                <span class="badge text-bg-success">Finalizada</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">En curso</span>
                            }
                        </td>
                        <td>
                            @if (!lectura.Finalizada)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Lecturas" asp-action="Leer" asp-route-lecturaId="@lectura.LecturaId">Continuar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
