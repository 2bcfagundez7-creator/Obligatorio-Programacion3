@model List<Obligatorio.WebLectores.Models.HistoriaPublicadaDTO>
@{
    ViewData["Title"] = "Historias";
    List<CategoriaDTO> categorias = ViewBag.Categorias ?? new List<CategoriaDTO>();
    int? categoriaSeleccionada = ViewBag.CategoriaId;
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1>Historias publicadas</h1>
        <p class="text-body-secondary">Elegí una historia y decidí cómo continúa.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Historial" asp-action="Index">Ver mis lecturas</a>
</div>

<form method="get" asp-controller="Historias" asp-action="Index" class="row g-2 mb-4">
    <div class="col-sm-6 col-md-4">
        <label class="form-label" for="categoriaId">Filtrar por categoría</label>
        <select class="form-select" id="categoriaId" name="categoriaId">
            <option value="">Todas las categorías</option>
            @foreach (CategoriaDTO categoria in categorias)
            {
                <option value="@categoria.Id" selected="@(categoriaSeleccionada == categoria.Id)">@categoria.Nombre</option>
            }
        </select>
    </div>
    <div class="col-auto align-self-end"><button class="btn btn-outline-primary" type="submit">Filtrar</button></div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Count == 0)
{
    <div class="empty-state">No hay historias publicadas por ahora.</div>
}
else
{
    <div class="row g-3">
        @foreach (var historia in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="text-body-secondary small mb-2">Historia #@historia.Id</div>
                        <h2 class="h5">@historia.Titulo</h2>
                        <p class="text-body-secondary flex-grow-1">@historia.Sinopsis</p>
                        <p class="small text-body-secondary">@string.Join(", ", historia.Categorias)</p>
                        <form method="post" asp-controller="Lecturas" asp-action="Iniciar" asp-antiforgery="true">
                            <input type="hidden" name="historiaId" value="@historia.Id" />
                            <button type="submit" class="btn btn-primary w-100">Comenzar aventura</button>
                        </form>
                    </div>
                </article>
            </div>
        }
    </div>
}
