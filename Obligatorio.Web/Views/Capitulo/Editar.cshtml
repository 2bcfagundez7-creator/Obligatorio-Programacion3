@model Obligatorio.LogicaNegocio.Entidades.Capitulo
@{
    ViewData["Title"] = "Editar capítulo";
    int historiaId = (int)ViewBag.HistoriaId;
}

<h2>Editar capítulo</h2>
<p>Capítulo #@Model.Id · @(Model.EsFinal ? "Final" : "Intermedio")</p>

@if (ViewBag.Error != null)
{
    <p class="text-danger">@ViewBag.Error</p>
}

<form method="post" asp-antiforgery="true" asp-controller="Capitulo" asp-action="Editar" asp-antiforgery="true">
    <input type="hidden" name="historiaId" value="@historiaId" />
    <input type="hidden" name="capituloId" value="@Model.Id" />

    <div class="mb-3">
        <label for="titulo">Título</label>
        <input class="form-control" type="text" id="titulo" name="titulo" value="@Model.Titulo" required />
    </div>
    <div class="mb-3">
        <label for="texto">Texto</label>
        <textarea class="form-control" id="texto" name="texto" rows="8" required>@Model.Texto</textarea>
    </div>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-outline-secondary" asp-controller="Capitulo" asp-action="Listar" asp-route-historiaId="@historiaId">Cancelar</a>
</form>
