@using Obligatorio.LogicaNegocio.Entidades

@{
    ViewData["Title"] = "Crear capítulo";
}

<h2>Crear capítulo</h2>

@if (ViewBag.Error != null)
{
    <p>@ViewBag.Error</p>
}

<form method="get" asp-controller="Capitulo" asp-action="Crear">
    <div>
        <label>Historia</label>

        <select name="historiaId">
            <option value="">Seleccione una historia</option>

            @foreach (Historia historia in ViewBag.Historias)
            {
                <option value="@historia.Id"
                        selected="@(ViewBag.HistoriaId == historia.Id)">
                    @historia.Titulo
                </option>
            }
        </select>

        <button type="submit">Seleccionar historia</button>
    </div>
</form>

@if (ViewBag.HistoriaId != null)
{
    <hr />

    <h3>Nuevo capítulo</h3>

    <form method="post" asp-controller="Capitulo" asp-action="Crear">

        <input type="hidden" name="historiaId"
               value="@ViewBag.HistoriaId" />

        <div>
            <label>Capítulo anterior</label>

            <select name="capituloAnteriorId">
                @foreach (CapituloIntermedio capitulo in ViewBag.Capitulos)
                {
                    <option value="@capitulo.Id">
                        @capitulo.Titulo
                    </option>
                }
            </select>
        </div>

        <div>
            <label>Tipo de capítulo</label>

            <select name="tipo">
                <option value="Intermedio">Intermedio</option>
                <option value="Final">Final</option>
            </select>
        </div>

        <div>
            <label>Título del capítulo</label>
            <input type="text" name="titulo" required />
        </div>

        <div>
            <label>Texto del capítulo</label>
            <textarea name="texto" required></textarea>
        </div>

        <div>
            <label>Texto de la opción</label>
            <input type="text" name="textoOpcion" required />
        </div>

        <br />

        <button type="submit">Crear capítulo</button>
    </form>
}
