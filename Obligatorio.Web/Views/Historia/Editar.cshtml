@model Obligatorio.LogicaNegocio.Entidades.Historia

@{
    ViewData["Title"] = "Editar historia";
}

<h2>Editar historia</h2>

@if (ViewBag.Error != null)
{
    <p>@ViewBag.Error</p>
}

<form method="post" asp-controller="Historia" asp-action="Editar">

    <input type="hidden" name="id" value="@Model.Id" />

    <div>
        <label>Título</label>
        <input type="text" name="titulo" value="@Model.Titulo" />
    </div>

    <div>
        <label>Sinopsis</label>
        <textarea name="sinopsis">@Model.Sinopsis</textarea>
    </div>

    <div>
        <label>Estado</label>

        <select name="estado">
            <option value="BORRADOR">BORRADOR</option>
            <option value="PUBLICADA">PUBLICADA</option>
        </select>
    </div>

    <br />

    <button type="submit">Guardar cambios</button>

</form>